# URL publique du site (SEO : sitemap, métadonnées, partage). En prod : https://123soleil-cinema.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optionnel: URL serveur (fallback SEO si NEXT_PUBLIC_SITE_URL absent)
SITE_URL=http://localhost:3000
# Vérification Google Search Console (meta tag)
GOOGLE_SITE_VERIFICATION=

DIRECTUS_URL=http://localhost:8055
DIRECTUS_PUBLIC_URL=http://localhost:8055
# Admin Directus : mêmes identifiants que pour te connecter à /admin (utilisés par schema:apply et setup)
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=ChangeMe123!
DIRECTUS_KEY=change-me-key
DIRECTUS_SECRET=change-me-secret
DIRECTUS_CORS_ORIGIN=http://localhost:3000
DIRECTUS_TOKEN=

# Contact : adresse principale (redirection des mails) et fallback
CONTACT_EMAIL_PRIMARY=123soleilcinemasolidaire@gmail.com
CONTACT_EMAIL_FALLBACK=takcastel@gmail.com

# HelloAsso (adhésion et dons)
HELLOASSO_ADHESION_URL=https://www.helloasso.com/associations/123-soleil-cinema-solidaire/adhesions/123-soleil-cinema-solidaire
HELLOASSO_DON_URL=https://www.helloasso.com/associations/123-soleil-cinema-solidaire/formulaires/1

# Resend (envoi des mails depuis la page contact)
RESEND_API_KEY=
# Adresse expéditrice (ex: "1,2,3 Soleil <onboarding@resend.dev>" pour test, ou votre domaine vérifié)
RESEND_FROM="1,2,3 Soleil <onboarding@resend.dev>"

POSTGRES_USER=directus
POSTGRES_PASSWORD=directus_password
POSTGRES_DB=directus
