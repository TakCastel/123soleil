# Image de dev : deps + next dev avec watch (pas de build de prod)
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
# Variables passées au build (pour next dev)
ARG NEXT_PUBLIC_DIRECTUS_URL
ARG NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_DIRECTUS_URL=$NEXT_PUBLIC_DIRECTUS_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL

COPY package.json package-lock.json* ./
RUN npm install

# Le code source est monté via le volume ; on lance le serveur de dev
EXPOSE 3000
# --webpack pour utiliser notre watchOptions (polling) sous Docker et éviter l'erreur Turbopack vs webpack
CMD ["sh", "-c", "npx next dev -H 0.0.0.0 --webpack"]
